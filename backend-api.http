# Built by Grain backend API requests. The IDE client retains response cookies.
@baseUrl = http://localhost:8080
@adminUsername = admin@example.com
@adminPassword = use-a-long-random-password
@newAdminPassword = replace-with-a-new-long-random-password
@productId = 1
@productSlug = oak-serving-board

### Health - public
GET {{baseUrl}}/api/health

### Catalog - public
GET {{baseUrl}}/api/public/products

### Product - public
GET {{baseUrl}}/api/public/products/{{productSlug}}

### Issue pre-login CSRF token
GET {{baseUrl}}/api/admin/auth/csrf
> {% client.global.set("csrfToken", response.body.token); %}

### Login and create a server session
POST {{baseUrl}}/api/admin/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "username": "{{adminUsername}}",
  "password": "{{adminPassword}}"
}

### Refresh CSRF token after authentication
GET {{baseUrl}}/api/admin/auth/csrf
> {% client.global.set("csrfToken", response.body.token); %}

### Inspect admin session
GET {{baseUrl}}/api/admin/auth/session

### Change password and invalidate every admin session
POST {{baseUrl}}/api/admin/auth/password
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "currentPassword": "{{adminPassword}}",
  "newPassword": "{{newAdminPassword}}"
}

### List all products - ADMIN session
GET {{baseUrl}}/api/admin/products

### Create product - ADMIN session + CSRF
POST {{baseUrl}}/api/admin/products
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Oak Serving Board",
  "slug": "oak-serving-board",
  "description": "Handmade oak board finished with food-safe oil.",
  "priceCents": 4900,
  "currency": "EUR",
  "inStock": true,
  "sizes": ["S", "M"],
  "active": true
}

### Deactivate product
PATCH {{baseUrl}}/api/admin/products/{{productId}}/deactivate
X-XSRF-TOKEN: {{csrfToken}}

### Activate product
PATCH {{baseUrl}}/api/admin/products/{{productId}}/activate
X-XSRF-TOKEN: {{csrfToken}}

### Delete product
DELETE {{baseUrl}}/api/admin/products/{{productId}}
X-XSRF-TOKEN: {{csrfToken}}

### Logout and invalidate the session
POST {{baseUrl}}/api/admin/auth/logout
X-XSRF-TOKEN: {{csrfToken}}
