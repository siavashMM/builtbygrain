# Copy to .env and replace both values before starting MinIO. The file is ignored.
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-local-secret
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=builtbygrain-media
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_CREATE_BUCKET=true

# Disposable cache for public catalog and storefront responses.
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=5m
CACHE_PRODUCT_DETAIL_TTL=30s
CACHE_KEY_PREFIX=builtbygrain:v1::

# Optional PostgreSQL streaming/read replica. Leave disabled for local development.
# When enabled, a missing replica username/password falls back to the primary values.
READ_REPLICA_ENABLED=false
READ_REPLICA_URL=
READ_REPLICA_USERNAME=
READ_REPLICA_PASSWORD=

# Customer sessions and local password-reset email.
CUSTOMER_SESSION_LIFETIME=30d
PASSWORD_RESET_LIFETIME=30m
PASSWORD_RESET_URL=http://localhost:4200/account/reset-password
MAIL_FROM=no-reply@builtbygrain.local
MAIL_HOST=localhost
MAIL_PORT=1025

# Optional checkout onboarding. Leave blank to keep the matching button/integration
# unavailable. Restrict the Google Maps browser key to your exact storefront origins.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAPS_BROWSER_KEY=
# Apple returns authorization by cross-site POST. Production Apple login requires
# SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAME_SITE=None.
SESSION_COOKIE_SAME_SITE=Lax
